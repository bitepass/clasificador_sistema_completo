# OSINT-Nexus Environment Variables
# Copia este archivo como .env y añade tus claves API

# Shodan API Key
# Obtener en: https://account.shodan.io/register
SHODAN_API_KEY=your_shodan_api_key_here

# Hunter.io API Key
# Obtener en: https://hunter.io/api-keys
HUNTER_API_KEY=your_hunter_api_key_here

# Have I Been Pwned API Key
# Obtener en: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=your_hibp_api_key_here

# Criminal IP API Key
# Obtener en: https://www.criminalip.io/
CRIMINAL_IP_API_KEY=your_criminal_ip_api_key_here

# URLScan.io API Key
# Obtener en: https://urlscan.io/
URLSCAN_API_KEY=your_urlscan_api_key_here

# Social Links API Key
# Obtener en: https://sociallinks.io/
SOCIAL_LINKS_API_KEY=your_social_links_api_key_here

# Proxy Configuration (opcional)
# PROXY_URL=http://proxy:port

# Configuración de seguridad
# ENABLE_TOR=false
# DATA_RETENTION_HOURS=24