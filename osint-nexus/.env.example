# OSINT-NEXUS Configuration File
# Copy this file to .env and fill in your API keys

# Shodan API - https://shodan.io
# Used for: Infrastructure analysis, open ports, vulnerabilities
SHODAN_API_KEY=

# Hunter.io API - https://hunter.io  
# Used for: Email verification and discovery
HUNTER_API_KEY=

# Have I Been Pwned API - https://haveibeenpwned.com/API/v3
# Used for: Data breach checking
HIBP_API_KEY=

# Criminal IP API - https://www.criminalip.io
# Used for: Threat intelligence and IP analysis
CRIMINAL_IP_API_KEY=

# Social Links API - https://sociallinks.io
# Used for: Social media profile analysis
SOCIAL_LINKS_API_KEY=

# URLScan.io API - https://urlscan.io
# Used for: Website analysis and screenshots
URLSCAN_API_KEY=

# VirusTotal API - https://www.virustotal.com
# Used for: Malware and threat detection
VIRUSTOTAL_API_KEY=

# Proxy Configuration (Optional)
# Set USE_PROXY to true to enable proxy
USE_PROXY=false
PROXY_URL=http://proxy.example.com:8080

# Additional Security Settings
# Enable OPSEC mode for enhanced privacy
OPSEC_MODE=false

# Rate Limiting (requests per minute)
RATE_LIMIT=60

# Debug Mode
DEBUG=false